---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/date";
import { SITE } from "../../site";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title={`${SITE.name} - Blog`}>
  <h1 class="mt-[2.2em] mb-[0.67em] text-center text-[3em] font-bold">Blog</h1>
  {
    posts.map((post) => (
      <div class="mx-auto w-7/10 border-b-2 border-line">
        <a href={`/blog/${post.id}/`}>
          <h2 class="my-[0.83em] text-[2.1em] font-bold text-primary underline">
            {post.data.title}
          </h2>
          <p class="my-[1em]">{post.data.description}</p>
          <p class="my-[1em] text-muted">{formatDate(post.data.date)}</p>
        </a>
      </div>
    ))
  }
</BaseLayout>
