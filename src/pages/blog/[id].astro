---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, cover, coverAlt, bibliography } = post.data;
const { Content } = await render(post);
---

<BaseLayout
  title={`${SITE.name} - Blog`}
  ogTitle={title}
  description={description}
  image={cover.src}
  ogType="article"
>
  <div class="mx-auto w-3/5 max-lg:mx-8 max-lg:w-auto">
    <p class="mt-32 mb-4">
      <a class="underline" href="/blog/">
        {' '}
        &lt; Retour aux articles
      </a>
    </p>
    <h1 class="my-8 text-center text-5xl font-bold underline">{title}</h1>
    <div>
      <Image class="my-4 inline h-auto max-w-full align-baseline" src={cover} alt={coverAlt} />
    </div>
    <div
      class:list={[
        '[&>p]:my-5 [&>p]:text-xl [&>p]:leading-relaxed',
        '[&_h2]:my-6 [&_h2]:text-3xl [&_h2]:font-bold [&_h2]:text-primary [&_h2]:underline',
        '[&_h3]:my-6 [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:underline',
        '[&_a]:underline',
        '[&_sub]:static [&_sub]:align-sub [&_sub]:text-base [&_sub]:leading-none',
        '[&_sup]:static [&_sup]:align-super [&_sup]:text-base [&_sup]:leading-none',
        '[&_figure]:mx-auto [&_figure]:my-12 [&_figure]:w-4/5 max-lg:[&_figure]:w-full',
        '[&_figure[data-size=small]]:w-3/5 max-md:[&_figure[data-size=small]]:w-full',
        '[&_figure>p]:my-4 [&_figure>p]:text-center [&_figure>p]:text-lg [&_figure>p]:italic',
        '[&_figure_img]:inline [&_figure_img]:h-auto [&_figure_img]:w-full [&_figure_img]:align-baseline',
      ]}
    >
      <Content />
    </div>
    {bibliography.length > 0 && (
      <>
        <h3 class="my-6 text-2xl font-bold underline">Bibliographie</h3>
        <div class="flex flex-col">
          {bibliography.map((url) => (
            <a
              class="mb-2 text-lg underline wrap-anywhere"
              href={url}
              target="_blank"
            >
              {url}
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>
