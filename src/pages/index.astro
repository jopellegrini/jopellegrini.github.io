---
import Contact from '../components/sections/Contact.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
---

<BaseLayout>
  <div class="relative mt-12 flex h-125 w-full overflow-hidden bg-primary text-white max-lg:mt-0">
    <div
      class="absolute top-0 left-0 flex h-full w-1/2 justify-end bg-cover bg-center max-xl:w-1/2 max-sm:w-4/5"
      style="background-image: url(/images/joseph.png)"
    >
      <div class="relative size-0 border-b-500 border-l-150 border-b-primary border-l-transparent"></div>
    </div>
    <div class="relative z-2 flex w-full justify-end bg-black/10 pt-37.5">
      <div class="w-1/2 max-xl:w-9/20">
        <h1 class="my-7 pr-2.5 text-4xl font-medium">{SITE.name}</h1>
        <p class="my-6 pr-2.5 text-2xl">{SITE.headline}</p>
      </div>
    </div>
  </div>
  <div class="mx-auto flex gap-8 w-4/5 flex-col">
    <Experience />
    <Education />
    <Skills />
    <Projects />
    <Contact />
  </div>
</BaseLayout>
