---
import Contact from '../components/sections/Contact.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
---

<BaseLayout>
  <div class="relative mt-[3em] flex h-125 w-full overflow-hidden bg-primary text-white max-lg:mt-0">
    <div class="absolute top-0 left-0 flex h-full w-1/2 justify-end bg-[url(/images/joseph.png)] bg-cover bg-center max-xl:w-1/2 max-sm:w-4/5">
      <div class="relative size-0 border-b-500 border-l-150 border-b-primary border-l-transparent"></div>
    </div>
    <div class="relative z-2 box-content w-full max-w-full bg-black/10 pt-37.5 pl-[50%] max-xl:pl-[55%]">
      <h1 class="my-[0.67em] pr-2.5 text-[2.5em] font-bold">{SITE.name}</h1>
      <p class="my-[1em] pr-2.5 text-[1.5em]">{SITE.headline}</p>
    </div>
  </div>
  <div class="mx-auto flex w-4/5 flex-col">
    <Experience />
    <Education />
    <Skills />
    <Projects />
    <Contact />
  </div>
</BaseLayout>
