---
import { Icon } from 'astro-icon/components';
import { SITE } from '../site';

const year = new Date().getFullYear();
---

<footer class="pt-10 text-center">
  <p class="my-[1em]">
    Copyright <Icon name="fa6-regular:copyright" class="inline align-baseline" aria-hidden="true" />{' '}
    {`${year} - ${SITE.name}`}
  </p>
</footer>
