---
import { Icon } from 'astro-icon/components';
import { SITE } from '../site';

const links = [
  { href: '/#experience', label: 'Expérience' },
  { href: '/#education', label: 'Formation' },
  { href: '/#skills', label: 'Compétences' },
  { href: '/#projects', label: 'Projets' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="group w-full">
  <input type="checkbox" id="nav-toggle" class="sr-only" aria-label="Menu" />
  <nav class="fixed top-0 z-990 flex h-14 w-full items-center justify-between bg-primary text-xl text-white max-lg:hidden max-lg:h-auto max-lg:flex-col max-lg:text-center group-has-checked:max-lg:flex">
    <div class="ml-5 max-lg:mt-14 max-lg:ml-0 max-lg:h-10">
      <a href="/">{SITE.name}</a>
    </div>
    <ul
      class="flex flex-row max-lg:flex-col"
      onclick="document.getElementById('nav-toggle').checked = false"
    >
      {links.map(({ href, label }) => (
        <li class="mx-5 max-lg:m-0 max-lg:h-10">
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
    <div class="mr-5 max-lg:mr-0 max-lg:mb-5">
      <a href="/blog/">Blog</a>
    </div>
  </nav>
  <label
    for="nav-toggle"
    class="fixed top-0 z-999 m-4 box-content hidden cursor-pointer rounded-md bg-primary p-4 transition-all duration-200 ease-in-out hover:bg-primary-light max-lg:flex max-lg:h-8"
  >
    <Icon name="menu" size="2em" class="group-has-checked:hidden" aria-hidden="true" />
    <Icon name="close" size="2em" class="hidden group-has-checked:block" aria-hidden="true" />
  </label>
</header>
