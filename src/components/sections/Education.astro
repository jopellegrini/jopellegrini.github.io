---
import { getOrderedCollection } from "../../lib/collections";
import SectionTitle from "../SectionTitle.astro";

const entries = await getOrderedCollection("education");
---

<div>
  <SectionTitle id="education" title="Formation" />
  <div class="main-section__sub">
    {
      entries.map(({ data }) => (
        <div class="main-section__education">
          <p class="main-section__education__title">{data.title}</p>
          {data.details && <p>{data.details}</p>}
          <p>
            <b>{data.school}</b>
          </p>
          <p class="main-section__education__date">{data.period}</p>
        </div>
      ))
    }
  </div>
</div>
