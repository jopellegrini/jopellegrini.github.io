---
import { getOrderedCollection } from '../../lib/collections';
import DatedCard from '../DatedCard.astro';
import SectionTitle from '../SectionTitle.astro';

const entries = await getOrderedCollection('education');
---

<div>
  <SectionTitle id="education" title="Formation" />
  <div class="flex flex-col gap-4">
    {entries.map(({ data }) => (
      <DatedCard title={data.title} subtitle={data.school} period={data.period}>
        {data.details && <p>{data.details}</p>}
      </DatedCard>
    ))}
  </div>
</div>
