---
import { Icon } from 'astro-icon/components';
import { getOrderedCollection } from '../../lib/collections';
import Card from '../Card.astro';
import SectionTitle from '../SectionTitle.astro';
import TechBadge from '../TechBadge.astro';

const groups = await getOrderedCollection('skills');
const languages = await getOrderedCollection('languages');
---

<div>
  <SectionTitle id="skills" title="Compétences" />
  <div class="flex flex-col gap-4">
    <h3 class="m-0 text-[1.17em] font-bold underline">Informatique</h3>
    <div class="flex flex-col gap-2">
      {groups.map(({ data }) => (
        <Card class="p-4 flex flex-col gap-2">
          <p>{data.title}</p>
          <div class="flex flex-wrap gap-4">
            {data.items.map((item) => (
              <TechBadge {...item} />
            ))}
          </div>
        </Card>
      ))}
    </div>

    <h3 class="m-0 text-[1.17em] font-bold underline">Langues</h3>
    <div>
      {languages.map(({ data }) => (
        <div class="flex items-center">
          <Icon name={data.icon} class="mr-[0.5em] size-[2em]" aria-hidden="true" />
          <p class="my-[1em]">{data.label}</p>
        </div>
      ))}
    </div>
  </div>
</div>
