---
import { getOrderedCollection } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';
import DatedCard from '../DatedCard.astro';
import SectionTitle from '../SectionTitle.astro';
import TechBadge from '../TechBadge.astro';

const projects = await getOrderedCollection('projects');
---

<div>
  <SectionTitle id="projects" title="Projets" />
  <div class="grid gap-4 md:grid-cols-2">
    {projects.map(({ data }) => (
      <DatedCard title={data.title} period={data.period}>
        <Fragment set:html={renderMarkdown(data.description)} />
        <Fragment slot="footer">
          {data.tech.map((item) => (
            <TechBadge {...item} />
          ))}
        </Fragment>
      </DatedCard>
    ))}
  </div>
</div>
