---
import { getOrderedCollection } from "../../lib/collections";
import { renderMarkdown } from "../../lib/markdown";
import SectionTitle from "../SectionTitle.astro";

const entries = await getOrderedCollection("experience");
---

<div>
  <SectionTitle id="experience" title="Expérience" />
  <div class="main-section__sub">
    {
      entries.map(({ data }) => (
        <div class="main-section__experience">
          <p class="main-section__experience__title">{data.title}</p>
          <p>
            <b>{data.company}</b>
          </p>
          <Fragment set:html={renderMarkdown(data.description)} />
          <p class="main-section__experience__date">{data.period}</p>
        </div>
      ))
    }
  </div>
</div>
