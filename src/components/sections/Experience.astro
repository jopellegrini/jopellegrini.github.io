---
import { getOrderedCollection } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';
import DatedCard from '../DatedCard.astro';
import SectionTitle from '../SectionTitle.astro';

const entries = await getOrderedCollection('experience');
---

<div>
  <SectionTitle id="experience" title="Expérience" />
  <div class="flex flex-col gap-4">
    {entries.map(({ data }) => (
      <DatedCard title={data.title} subtitle={data.company} startDate={data.startDate} endDate={data.endDate}>
        <Fragment set:html={renderMarkdown(data.description)} />
      </DatedCard>
    ))}
  </div>
</div>
