---
import { Icon } from "astro-icon/components";
import SectionTitle from "../SectionTitle.astro";

const links = [
  { href: "mailto:jopellegrini2@gmail.com", icon: "fa6-solid:envelope", label: "E-mail", external: false },
  { href: "https://www.linkedin.com/in/joseph-pellegrini/", icon: "fa6-brands:linkedin", label: "LinkedIn", external: true },
  { href: "https://github.com/jopellegrini", icon: "fa6-brands:github", label: "GitHub", external: true },
];
---

<div>
  <SectionTitle id="contact" title="Contact" />
  <div>
    <div class="flex items-center justify-center text-[3em] max-xs:flex-col">
      {
        links.map(({ href, icon, label, external }) => (
          <a
            class="box-content size-[1em] cursor-pointer rounded-full border-2 border-primary bg-primary p-[0.3em] text-center text-page transition-all duration-200 ease-[ease] not-last:mr-[1em] hover:bg-primary-hover max-xs:mt-[0.6em] max-xs:not-last:mr-0"
            href={href}
            target={external ? "_blank" : undefined}
            aria-label={label}
          >
            <Icon name={icon} class="inline align-super" aria-hidden="true" />
          </a>
        ))
      }
    </div>
  </div>
</div>
