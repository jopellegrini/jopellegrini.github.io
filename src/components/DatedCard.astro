---
import { describePeriod } from '../lib/period';
import Card from './Card.astro';

interface Props {
  title: string;
  subtitle?: string;
  startDate: string;
  endDate?: string;
}

const { title, subtitle, startDate, endDate } = Astro.props;
const { range, duration } = describePeriod(startDate, endDate);
---

<Card class="flex flex-col gap-3 p-5">
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <div>
      <h3 class="text-lg font-medium text-primary">{title}</h3>
      {subtitle && <p class="text-primary-light">{subtitle}</p>}
    </div>
    <p class="text-sm text-muted">{range} · {duration}</p>
  </header>
  {Astro.slots.has('default') && (
    <div class="flex flex-col gap-2 text-neutral-700 empty:hidden">
      <slot />
    </div>
  )}
  {Astro.slots.has('footer') && (
    <footer class="mt-auto flex flex-wrap gap-4">
      <slot name="footer" />
    </footer>
  )}
</Card>
