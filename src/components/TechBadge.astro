---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  icon: string;
}

const { name, icon } = Astro.props;
---

<div class="inline-flex items-center gap-1.5 rounded-sm border border-line px-1.5 py-1">
  <Icon name={icon} class="h-auto w-6" aria-hidden="true" />
  <p class="m-0">{name}</p>
</div>
