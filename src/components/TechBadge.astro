---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  icon: string;
}

const { name, icon } = Astro.props;
---

<div class="rounded-sm border border-line px-1.5 py-0.5 text-lg">
  <Icon name={icon} class="inline h-auto w-7 align-baseline" aria-hidden="true" />{' '}
  <p class="m-0 inline-block align-super leading-9">{name}</p>
</div>
