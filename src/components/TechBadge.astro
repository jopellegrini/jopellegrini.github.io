---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  icon: string;
}

const { name, icon } = Astro.props;
---

<div class="m-[0.8em] rounded-sm border border-line px-[0.3em] py-[0.1em] text-[1.1em]">
  <Icon name={icon} class="inline h-auto w-[1.6em] align-baseline" aria-hidden="true" />{" "}<p class="m-0 inline-block align-super leading-[2em]">{name}</p>
</div>
